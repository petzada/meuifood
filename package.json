{
  "name": "foode-delivery",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "prepare": "node -e \"try{if(require('fs').existsSync('.git'))require('child_process').execSync('lefthook install',{stdio:'inherit'})}catch(e){console.warn('lefthook install ignorado')}\"",
    "build:packages": "pnpm --filter @foode/shared --filter @foode/ui build",
    "dev": "pnpm run build:packages && pnpm --parallel --filter './apps/*' dev",
    "format": "prettier --write .",
    "lint": "eslint --cache --cache-location node_modules/.cache/eslint/ --max-warnings=0 . && node scripts/lint-migrations.mjs",
    "typecheck": "pnpm run build:packages && pnpm -r --if-present typecheck",
    "test": "pnpm run build:packages && vitest run",
    "test:coverage": "pnpm run build:packages && vitest run --coverage",
    "test:related": "node scripts/test-related.mjs",
    "test:workers": "pnpm -r --if-present test:workers",
    "test:ci": "pnpm test:coverage && pnpm test:workers",
    "e2e": "node scripts/smoke.mjs && playwright test -c scripts/e2e/playwright.config.mjs",
    "build": "pnpm run build:packages && pnpm -r --if-present build",
    "build:cf": "pnpm run build:packages && pnpm -r --if-present build:cf",
    "db:generate": "pnpm --filter @foode/db generate"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^9.39.2",
    "@playwright/test": "^1.64.1",
    "@vitest/coverage-v8": "^4.1.12",
    "eslint": "^9.39.2",
    "globals": "^16.5.0",
    "lefthook": "^2.2.2",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.49.0",
    "vitest": "^4.1.12"
  }
}
