{
  "name": "foode-delivery",
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "build:packages": "pnpm --filter @foode/shared build && pnpm --filter @foode/db build && pnpm --filter @foode/ui build",
    "dev": "pnpm run build:packages && pnpm --parallel --filter './apps/*' dev",
    "lint": "pnpm -r --if-present lint",
    "typecheck": "pnpm run build:packages && pnpm -r --if-present typecheck",
    "test": "pnpm run build:packages && pnpm -r --if-present test",
    "build": "pnpm -r --if-present build"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "eslint": "^9.39.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.49.0"
  }
}
