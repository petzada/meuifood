// Worker `foode-api` (Hono). Decisão 59 / ADR 0006.
// - fetch público: /health, /storefront/*, /media/* (imagens do Cardápio), /webhooks/* (src/app.ts);
// - entrypoint RPC `PainelApi` (src/painel.ts): só por service binding (admin).
// Deploy só pelo CI (.github/workflows/deploy.yml). Custom domain `api.foodedelivery.com.br`
// (Ticket 25; o deploy cria o registro DNS e o certificado). O workers.dev segue ligado como
// fallback do smoke.
// Segredos (SENTRY_DSN, MILLIONSEND_API_KEY, BETTER_AUTH_SECRET, TURNSTILE_SECRET_KEY e, do Ticket
// 24a, ORDER_TOKEN_SECRET e PHONE_LOOKUP_IP_SALT) chegam no deploy (`--secrets-file`,
// sincronizados dos secrets do GitHub). Nunca em arquivo nem em `vars`.
// Ticket 13 (login do Consumidor pelo WhatsApp, decisão 65): WHATSMIAU_API_KEY e
// WHATSMIAU_INSTANCE_ID são secrets OPCIONAIS (sincronizados se existirem no GitHub); sem eles o
// login responde "Login pelo WhatsApp indisponível no momento". WHATSMIAU_API_URL (GitHub variable,
// opcional) troca a base padrão https://api.whatsmiau.dev/v2.
// Ticket 26 (PIX AbacatePay, decisão 60): ABACATEPAY_API_KEY, ABACATEPAY_WEBHOOK_SECRET e
// ABACATEPAY_SIGNING_KEY são secrets OPCIONAIS (sincronizados se existirem no GitHub); sem os três,
// PIX fica indisponível no checkout e `/webhooks/abacatepay` responde 503. O webhook é cadastrado
// na AbacatePay pelo workflow manual setup-abacatepay-webhook (depois de criar as chaves).
// Vars de Auth (Ticket 22): os valores abaixo são o padrão; o deploy sobrescreve com as GitHub
// variables BETTER_AUTH_URL e EMAIL_FROM quando existirem (`--var`).
// - BETTER_AUTH_URL: URL pública do Painel (o admin repassa /api/auth/*): base dos links e origem
//   confiável. Domínio do Painel desde o Ticket 25.
// - EMAIL_FROM: remetente da MillionSend. O domínio é cadastrado e verificado pelo workflow
//   setup-email-dominio (Ticket 25); antes disso o envio falha de forma controlada (log
//   `email_send_failed` com o status, sem dados pessoais).
// CPU: o hash de senha padrão do Better Auth (scrypt nativo) custa ~100 ms por login; o teto do
// Workers Paid (30 s de CPU por request) basta, sem `limits.cpu_ms`.
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "foode-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "routes": [{ "pattern": "api.foodedelivery.com.br", "custom_domain": true }],
  "preview_urls": false,
  "observability": { "enabled": true },
  "vars": {
    "ENVIRONMENT": "production",
    "BETTER_AUTH_URL": "https://admin.foodedelivery.com.br",
    "EMAIL_FROM": "Foode <nao-responda@foodedelivery.com.br>",
    // Ticket 23 (decisão 64): base pública das imagens do Cardápio = rota `/media` desta api.
    // Domínio próprio desde o Ticket 25.
    "MEDIA_PUBLIC_BASE_URL": "https://api.foodedelivery.com.br/media",
    // Ticket 31 (decisão 70): aviso de lead novo da landing pela MillionSend. É o e-mail do
    // próprio Dono da Foode (não é dado de terceiro nem segredo).
    "LEADS_NOTIFY_EMAIL": "marciopetigrosso@gmail.com",
  },
  // D1 de produção (GitHub variable D1_PROD_DATABASE_ID). Migrations: packages/db/migrations,
  // aplicadas só pelo workflow db-migrate (confirmar=aplicar).
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "foode-prod",
      "database_id": "08fc0f44-ebb6-4712-b857-a566a82beead",
      "migrations_dir": "../../packages/db/migrations",
    },
  ],
  // Imagens do Cardápio (decisões 57/59/64): sem credenciais S3. O upload chega em bytes pela RPC
  // e o binding grava/apaga sob `stores/{store_id}/menu/`; leitura pública por `GET /media/*`.
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "foode-media" }],
}
