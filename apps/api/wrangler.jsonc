// Worker `foode-api` (Hono). Decisão 59 / ADR 0006.
// - fetch público: /health, /storefront/*, /webhooks/* (src/app.ts);
// - entrypoint RPC `PainelApi` (src/painel.ts): só por service binding (admin).
// Deploy só pelo CI (.github/workflows/deploy.yml). Sem routes/custom domains até a zona
// foodedelivery.com.br ficar ativa (Ticket 25): publica em workers.dev.
// Segredos (SENTRY_DSN, MILLIONSEND_API_KEY, BETTER_AUTH_SECRET, TURNSTILE_SECRET_KEY) chegam no
// deploy (`--secrets-file`, sincronizados dos secrets do GitHub).
// Vars de Auth (Ticket 22): os valores abaixo são o padrão; o deploy sobrescreve com as GitHub
// variables BETTER_AUTH_URL e EMAIL_FROM quando existirem (`--var`).
// - BETTER_AUTH_URL: URL pública do Painel (o admin repassa /api/auth/*): base dos links e origem
//   confiável. Hoje o workers.dev do admin; vira o domínio do Painel no Ticket 25.
// - EMAIL_FROM: remetente da MillionSend. Enquanto foodedelivery.com.br não estiver verificado lá,
//   o envio falha de forma controlada (log `email_send_failed` com o status, sem dados pessoais).
// CPU: o hash de senha padrão do Better Auth (scrypt nativo) custa ~100 ms por login; o teto do
// Workers Paid (30 s de CPU por request) basta, sem `limits.cpu_ms`.
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "foode-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "observability": { "enabled": true },
  "vars": {
    "ENVIRONMENT": "production",
    "BETTER_AUTH_URL": "https://foode-admin.marciopetigrosso.workers.dev",
    "EMAIL_FROM": "Foode <no-reply@foodedelivery.com.br>",
    // Ticket 23: nome do bucket para assinar o PUT na API S3 do R2 (mesmo do binding MEDIA).
    // R2_ACCOUNT_ID e R2_PUBLIC_BASE_URL chegam do deploy (`--var`) quando existirem;
    // R2_ACCESS_KEY_ID/R2_SECRET_ACCESS_KEY são secrets. Sem eles o upload responde erro controlado.
    "R2_BUCKET": "foode-media",
  },
  // D1 de produção (GitHub variable D1_PROD_DATABASE_ID). Migrations: packages/db/migrations,
  // aplicadas só pelo workflow db-migrate (confirmar=aplicar).
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "foode-prod",
      "database_id": "08fc0f44-ebb6-4712-b857-a566a82beead",
      "migrations_dir": "../../packages/db/migrations",
    },
  ],
  // Imagens do Cardápio (decisão 57/59): leitura pública por R2_PUBLIC_BASE_URL; o binding
  // confere/apaga objetos sob `stores/{store_id}/menu/`.
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "foode-media" }],
}
