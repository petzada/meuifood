{
  "name": "@foode/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "provision:owner": "tsx src/provision-owner.ts",
    "lint": "eslint src --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test:quality": "vitest run src/app.test.ts",
    "test": "vitest run",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js"
  },
  "dependencies": {
    "@foode/db": "workspace:*",
    "@foode/shared": "workspace:*",
    "@sentry/node": "^10.68.0",
    "@supabase/supabase-js": "^2.110.9",
    "fastify": "^5.10.0",
    "jose": "^6.2.4",
    "pino": "^10.3.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.21.0",
    "vitest": "^4.1.10"
  }
}
