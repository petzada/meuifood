{
  "name": "@foode/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "provision:owner": "tsx src/provision-owner.ts",
    "migrations:preflight": "tsx scripts/preflight-production-migrations.ts",
    "lint": "eslint src scripts --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test:quality": "vitest run src/app.test.ts src/menu-images.test.ts src/store-operation.test.ts src/order-idempotency.test.ts scripts/migration-preflight-policy.test.mjs",
    "test": "vitest run",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1097.0",
    "@aws-sdk/s3-request-presigner": "3.1097.0",
    "@foode/db": "workspace:*",
    "@foode/shared": "workspace:*",
    "@js-temporal/polyfill": "^0.5.1",
    "@sentry/node": "^10.68.0",
    "@supabase/supabase-js": "^2.110.9",
    "fastify": "^5.10.0",
    "jose": "^6.2.4",
    "pino": "^10.3.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.21.0",
    "vitest": "^4.1.10"
  }
}
