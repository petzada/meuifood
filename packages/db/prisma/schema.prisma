generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  // O Prisma decide a extensao dos imports relativos olhando o tsconfig mais
  // proximo. Nosso tsconfig.base usa moduleResolution "Bundler" (para o dev
  // com tsx/vitest), entao ele gerava imports sem extensao (ex.:
  // "./internal/class"). O tsc so transpila e nao reescreve especificadores,
  // entao o dist/*.js final ficava com imports sem extensao. O Node ESM puro
  // (sem bundler) exige o caminho exato do arquivo e falha com
  // ERR_MODULE_NOT_FOUND ao rodar "node dist/server.js" em producao. Fixamos
  // a extensao em "js" para casar com o que o tsc realmente emite.
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum BillingMode {
  pilot_platform
  baas
  merchant_own_account

  @@map("billing_mode")
}

enum MembershipRole {
  owner
  operator

  @@map("membership_role")
}

model Store {
  id          String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  taxId       String         @unique @map("tax_id")
  name        String
  slug        String         @unique
  billingMode BillingMode    @map("billing_mode")
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)
  members     StoreMember[]
  categories  MenuCategory[]
  items       MenuItem[]

  @@map("stores")
}

model StoreMember {
  id        String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  storeId   String         @map("store_id") @db.Uuid
  userId    String         @map("user_id") @db.Uuid
  role      MembershipRole
  createdAt DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)
  store     Store          @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, userId])
  @@index([userId])
  @@map("store_members")
}

model MenuCategory {
  id        String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  storeId   String     @map("store_id") @db.Uuid
  name      String
  sortOrder Int        @map("sort_order")
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)
  store     Store      @relation(fields: [storeId], references: [id], onDelete: Cascade)
  items     MenuItem[]

  @@index([storeId, sortOrder])
  @@map("menu_categories")
}

model MenuItem {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  storeId        String       @map("store_id") @db.Uuid
  categoryId     String       @map("category_id") @db.Uuid
  name           String
  description    String       @default("")
  priceCents     Int          @map("price_cents")
  imageObjectKey String?      @map("image_object_key")
  available      Boolean      @default(true)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  store          Store        @relation(fields: [storeId], references: [id], onDelete: Cascade)
  category       MenuCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@index([storeId, categoryId])
  @@map("menu_items")
}
