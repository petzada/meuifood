generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  // O Prisma decide a extensao dos imports relativos olhando o tsconfig mais
  // proximo. Nosso tsconfig.base usa moduleResolution "Bundler" (para o dev
  // com tsx/vitest), entao ele gerava imports sem extensao (ex.:
  // "./internal/class"). O tsc so transpila e nao reescreve especificadores,
  // entao o dist/*.js final ficava com imports sem extensao. O Node ESM puro
  // (sem bundler) exige o caminho exato do arquivo e falha com
  // ERR_MODULE_NOT_FOUND ao rodar "node dist/server.js" em producao. Fixamos
  // a extensao em "js" para casar com o que o tsc realmente emite.
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum BillingMode {
  pilot_platform
  baas
  merchant_own_account

  @@map("billing_mode")
}

enum MembershipRole {
  owner
  operator

  @@map("membership_role")
}

model Store {
  id                 String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  taxId              String                 @unique @map("tax_id")
  name               String
  slug               String                 @unique
  billingMode        BillingMode            @map("billing_mode")
  paused             Boolean                @default(false)
  pickupEnabled      Boolean                @default(true) @map("pickup_enabled")
  contactPhoneE164   String?                @map("contact_phone_e164")
  createdAt          DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime               @updatedAt @map("updated_at") @db.Timestamptz(3)
  members            StoreMember[]
  categories         MenuCategory[]
  items              MenuItem[]
  complementGroups   MenuComplementGroup[]
  complementOptions  MenuComplementOption[]
  additionals        MenuAdditional[]
  operatingPeriods   StoreOperatingPeriod[]
  orders             Order[]
  orderLines         OrderLine[]

  @@map("stores")
}

model StoreOperatingPeriod {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  storeId   String   @map("store_id") @db.Uuid
  weekday   Int      @db.SmallInt
  opensAt   String   @map("opens_at") @db.Char(5)
  closesAt  String   @map("closes_at") @db.Char(5)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, weekday, opensAt, closesAt])
  @@index([storeId, weekday, opensAt])
  @@map("store_operating_periods")
}

model StoreMember {
  id        String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  storeId   String         @map("store_id") @db.Uuid
  userId    String         @map("user_id") @db.Uuid
  role      MembershipRole
  createdAt DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)
  store     Store          @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, userId])
  @@index([userId])
  @@map("store_members")
}

model MenuCategory {
  id        String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  storeId   String     @map("store_id") @db.Uuid
  name      String
  sortOrder Int        @map("sort_order")
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)
  store     Store      @relation(fields: [storeId], references: [id], onDelete: Cascade)
  items     MenuItem[]

  @@index([storeId, sortOrder])
  @@map("menu_categories")
}

model MenuItem {
  id               String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  storeId          String                 @map("store_id") @db.Uuid
  categoryId       String                 @map("category_id") @db.Uuid
  name             String
  description      String                 @default("")
  priceCents       Int                    @map("price_cents")
  imageObjectKey   String?                @map("image_object_key")
  available        Boolean                @default(true)
  createdAt        DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime               @updatedAt @map("updated_at") @db.Timestamptz(3)
  store            Store                  @relation(fields: [storeId], references: [id], onDelete: Cascade)
  category         MenuCategory           @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  complementGroups MenuComplementGroup[]
  additionals      MenuAdditional[]

  @@unique([storeId, id])
  @@index([storeId, categoryId])
  @@map("menu_items")
}

model MenuComplementGroup {
  id        String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  storeId   String                 @map("store_id") @db.Uuid
  itemId    String                 @map("item_id") @db.Uuid
  name      String
  required  Boolean                @default(false)
  sortOrder Int                    @map("sort_order")
  createdAt DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime               @updatedAt @map("updated_at") @db.Timestamptz(3)
  store     Store                  @relation(fields: [storeId], references: [id], onDelete: Cascade)
  item      MenuItem               @relation(fields: [itemId], references: [id], onDelete: Cascade)
  options   MenuComplementOption[]

  @@unique([storeId, id])
  @@index([storeId, itemId, sortOrder])
  @@map("menu_complement_groups")
}

model MenuComplementOption {
  id        String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  storeId   String              @map("store_id") @db.Uuid
  groupId   String              @map("group_id") @db.Uuid
  name      String
  sortOrder Int                 @map("sort_order")
  createdAt DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)
  store     Store               @relation(fields: [storeId], references: [id], onDelete: Cascade)
  group     MenuComplementGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([storeId, groupId, sortOrder])
  @@map("menu_complement_options")
}

model MenuAdditional {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  storeId    String   @map("store_id") @db.Uuid
  itemId     String   @map("item_id") @db.Uuid
  name       String
  priceCents Int      @map("price_cents")
  available  Boolean  @default(true)
  sortOrder  Int      @map("sort_order")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  store      Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  item       MenuItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([storeId, itemId, sortOrder])
  @@map("menu_additionals")
}

enum OrderStatus {
  received
  preparing
  ready_for_pickup
  completed
  cancelled

  @@map("order_status")
}

enum FulfillmentType {
  pickup

  @@map("fulfillment_type")
}

enum PaymentMethod {
  on_delivery

  @@map("payment_method")
}

model Order {
  id                     String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  storeId                String          @map("store_id") @db.Uuid
  publicCode             String          @map("public_code")
  accessToken            String          @unique @map("access_token")
  status                 OrderStatus     @default(received)
  fulfillmentType        FulfillmentType @map("fulfillment_type")
  paymentMethod          PaymentMethod   @map("payment_method")
  guestName              String          @map("guest_name")
  guestPhoneE164         String          @map("guest_phone_e164")
  customerUserId         String?         @map("customer_user_id") @db.Uuid
  itemsTotalCents        Int             @map("items_total_cents")
  deliveryFeeCents       Int             @default(0) @map("delivery_fee_cents")
  totalCents             Int             @map("total_cents")
  idempotencyKey         String          @map("idempotency_key")
  idempotencyPayloadHash String          @map("idempotency_payload_hash")
  createdAt              DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)
  store                  Store           @relation(fields: [storeId], references: [id], onDelete: Cascade)
  lines                  OrderLine[]

  @@unique([storeId, id])
  @@unique([storeId, idempotencyKey])
  @@unique([storeId, publicCode])
  @@index([storeId, createdAt(sort: Desc)])
  @@index([storeId, status, createdAt(sort: Desc)])
  @@map("orders")
}

model OrderLine {
  id                   String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  storeId              String   @map("store_id") @db.Uuid
  orderId              String   @map("order_id") @db.Uuid
  sortOrder            Int      @map("sort_order")
  menuItemId           String?  @map("menu_item_id") @db.Uuid
  itemName             String   @map("item_name")
  unitPriceCents       Int      @map("unit_price_cents")
  quantity             Int
  lineTotalCents       Int      @map("line_total_cents")
  complementSnapshots  Json     @map("complement_snapshots")
  additionalSnapshots  Json     @map("additional_snapshots")
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  store                Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  order                Order    @relation(fields: [storeId, orderId], references: [storeId, id], onDelete: Cascade)

  @@index([storeId, orderId, sortOrder])
  @@index([orderId])
  @@map("order_lines")
}
