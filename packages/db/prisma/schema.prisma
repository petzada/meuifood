generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  // O Prisma decide a extensao dos imports relativos olhando o tsconfig mais
  // proximo. Nosso tsconfig.base usa moduleResolution "Bundler" (para o dev
  // com tsx/vitest), entao ele gerava imports sem extensao (ex.:
  // "./internal/class"). O tsc so transpila e nao reescreve especificadores,
  // entao o dist/*.js final ficava com imports sem extensao. O Node ESM puro
  // (sem bundler) exige o caminho exato do arquivo e falha com
  // ERR_MODULE_NOT_FOUND ao rodar "node dist/server.js" em producao. Fixamos
  // a extensao em "js" para casar com o que o tsc realmente emite.
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum BillingMode {
  pilot_platform
  baas
  merchant_own_account

  @@map("billing_mode")
}

enum MembershipRole {
  owner
  operator

  @@map("membership_role")
}

enum DeliveryFeeMode {
  fixed
  neighborhood

  @@map("delivery_fee_mode")
}

model Store {
  id                     String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  taxId                  String                  @unique @map("tax_id")
  name                   String
  slug                   String                  @unique
  billingMode            BillingMode             @map("billing_mode")
  paused                 Boolean                 @default(false)
  pickupEnabled          Boolean                 @default(true) @map("pickup_enabled")
  contactPhoneE164       String?                 @map("contact_phone_e164")
  deliveryFeeMode        DeliveryFeeMode?        @map("delivery_fee_mode")
  fixedDeliveryFeeCents  Int?                    @map("fixed_delivery_fee_cents")
  createdAt              DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime                @updatedAt @map("updated_at") @db.Timestamptz(3)
  members                StoreMember[]
  categories             MenuCategory[]
  items                  MenuItem[]
  complementGroups       MenuComplementGroup[]
  complementOptions      MenuComplementOption[]
  additionals            MenuAdditional[]
  operatingPeriods       StoreOperatingPeriod[]
  deliveryNeighborhoods  DeliveryNeighborhood[]
  orders                 Order[]
  orderLines             OrderLine[]
  paymentCharges         PaymentCharge[]
  paymentEvents          PaymentEvent[]
  ledgerEntries          LedgerEntry[]

  @@map("stores")
}

model DeliveryNeighborhood {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  storeId        String   @map("store_id") @db.Uuid
  name           String
  normalizedName String   @map("normalized_name")
  feeCents       Int      @map("fee_cents")
  sortOrder      Int      @map("sort_order")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  store          Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, normalizedName])
  @@index([storeId, sortOrder])
  @@map("delivery_neighborhoods")
}

model StoreOperatingPeriod {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  storeId   String   @map("store_id") @db.Uuid
  weekday   Int      @db.SmallInt
  opensAt   String   @map("opens_at") @db.Char(5)
  closesAt  String   @map("closes_at") @db.Char(5)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, weekday, opensAt, closesAt])
  @@index([storeId, weekday, opensAt])
  @@map("store_operating_periods")
}

model StoreMember {
  id        String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  storeId   String         @map("store_id") @db.Uuid
  userId    String         @map("user_id") @db.Uuid
  role      MembershipRole
  createdAt DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)
  store     Store          @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, userId])
  @@index([userId])
  @@map("store_members")
}

model MenuCategory {
  id        String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  storeId   String     @map("store_id") @db.Uuid
  name      String
  sortOrder Int        @map("sort_order")
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)
  store     Store      @relation(fields: [storeId], references: [id], onDelete: Cascade)
  items     MenuItem[]

  @@index([storeId, sortOrder])
  @@map("menu_categories")
}

model MenuItem {
  id               String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  storeId          String                 @map("store_id") @db.Uuid
  categoryId       String                 @map("category_id") @db.Uuid
  name             String
  description      String                 @default("")
  priceCents       Int                    @map("price_cents")
  imageObjectKey   String?                @map("image_object_key")
  available        Boolean                @default(true)
  createdAt        DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime               @updatedAt @map("updated_at") @db.Timestamptz(3)
  store            Store                  @relation(fields: [storeId], references: [id], onDelete: Cascade)
  category         MenuCategory           @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  complementGroups MenuComplementGroup[]
  additionals      MenuAdditional[]

  @@unique([storeId, id])
  @@index([storeId, categoryId])
  @@map("menu_items")
}

model MenuComplementGroup {
  id        String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  storeId   String                 @map("store_id") @db.Uuid
  itemId    String                 @map("item_id") @db.Uuid
  name      String
  required  Boolean                @default(false)
  sortOrder Int                    @map("sort_order")
  createdAt DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime               @updatedAt @map("updated_at") @db.Timestamptz(3)
  store     Store                  @relation(fields: [storeId], references: [id], onDelete: Cascade)
  item      MenuItem               @relation(fields: [itemId], references: [id], onDelete: Cascade)
  options   MenuComplementOption[]

  @@unique([storeId, id])
  @@index([storeId, itemId, sortOrder])
  @@map("menu_complement_groups")
}

model MenuComplementOption {
  id        String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  storeId   String              @map("store_id") @db.Uuid
  groupId   String              @map("group_id") @db.Uuid
  name      String
  sortOrder Int                 @map("sort_order")
  createdAt DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)
  store     Store               @relation(fields: [storeId], references: [id], onDelete: Cascade)
  group     MenuComplementGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([storeId, groupId, sortOrder])
  @@map("menu_complement_options")
}

model MenuAdditional {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  storeId    String   @map("store_id") @db.Uuid
  itemId     String   @map("item_id") @db.Uuid
  name       String
  priceCents Int      @map("price_cents")
  available  Boolean  @default(true)
  sortOrder  Int      @map("sort_order")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  store      Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  item       MenuItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([storeId, itemId, sortOrder])
  @@map("menu_additionals")
}

enum OrderStatus {
  received
  preparing
  ready_for_pickup
  out_for_delivery
  completed
  cancelled

  @@map("order_status")
}

enum FulfillmentType {
  pickup
  delivery

  @@map("fulfillment_type")
}

enum PaymentMethod {
  pix
  on_delivery

  @@map("payment_method")
}

enum PaymentStatus {
  not_required
  awaiting_payment
  paid

  @@map("payment_status")
}

enum PaymentProvider {
  woovi

  @@map("payment_provider")
}

enum ChargeStatus {
  pending
  active
  completed
  expired
  provider_error

  @@map("charge_status")
}

model Order {
  id                       String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  storeId                  String           @map("store_id") @db.Uuid
  publicCode               String           @map("public_code")
  /// SHA-256 hex (64 chars) do capability token opaco; token bruto nunca é persistido.
  accessToken              String           @unique @map("access_token")
  status                   OrderStatus      @default(received)
  fulfillmentType          FulfillmentType  @map("fulfillment_type")
  paymentMethod            PaymentMethod    @map("payment_method")
  paymentStatus            PaymentStatus    @default(not_required) @map("payment_status")
  guestName                String           @map("guest_name")
  guestPhoneE164           String           @map("guest_phone_e164")
  customerUserId           String?          @map("customer_user_id") @db.Uuid
  itemsTotalCents          Int              @map("items_total_cents")
  deliveryFeeCents         Int              @default(0) @map("delivery_fee_cents")
  totalCents               Int              @map("total_cents")
  deliveryStreetLine       String?          @map("delivery_street_line")
  deliveryNeighborhood     String?          @map("delivery_neighborhood")
  deliveryComplement       String?          @map("delivery_complement")
  deliveryReference        String?          @map("delivery_reference")
  deliveryFeeModeSnapshot  DeliveryFeeMode? @map("delivery_fee_mode_snapshot")
  idempotencyKey           String           @map("idempotency_key")
  idempotencyPayloadHash   String           @map("idempotency_payload_hash")
  createdAt                DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  store                    Store            @relation(fields: [storeId], references: [id], onDelete: Cascade)
  lines                    OrderLine[]
  paymentCharge            PaymentCharge?
  ledgerEntry              LedgerEntry?

  @@unique([storeId, id])
  @@unique([storeId, idempotencyKey])
  @@unique([storeId, publicCode])
  @@index([storeId, createdAt(sort: Desc)])
  @@index([storeId, status, createdAt(sort: Desc)])
  @@map("orders")
}

/// Cobrança online (PIX Woovi no Ticket 10). Uma por Pedido.
model PaymentCharge {
  id               String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  storeId          String          @map("store_id") @db.Uuid
  orderId          String          @unique @map("order_id") @db.Uuid
  provider         PaymentProvider
  /// correlationID estável enviado ao provider (idempotência no gateway).
  correlationId    String          @unique @map("correlation_id")
  providerChargeId String?         @map("provider_charge_id")
  status           ChargeStatus    @default(pending)
  amountCents      Int             @map("amount_cents")
  brCode           String?         @map("br_code")
  qrCodeImage      String?         @map("qr_code_image")
  expiresAt        DateTime?       @map("expires_at") @db.Timestamptz(3)
  createdAt        DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)
  store            Store           @relation(fields: [storeId], references: [id], onDelete: Cascade)
  order            Order           @relation(fields: [storeId, orderId], references: [storeId, id], onDelete: Cascade)
  events           PaymentEvent[]
  ledgerEntry      LedgerEntry?

  @@unique([storeId, id])
  @@unique([storeId, orderId])
  @@index([storeId, status, createdAt(sort: Desc)])
  @@map("payment_charges")
}

/// Eventos de webhook com identidade única do provider (at-least-once).
model PaymentEvent {
  id              String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  storeId         String          @map("store_id") @db.Uuid
  chargeId        String?         @map("charge_id") @db.Uuid
  provider        PaymentProvider
  providerEventId String          @map("provider_event_id")
  eventType       String          @map("event_type")
  /// Payload sanitizado (sem secrets); raw assinado fica só em memória de verificação.
  payload         Json
  processedAt     DateTime?       @map("processed_at") @db.Timestamptz(3)
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  store           Store           @relation(fields: [storeId], references: [id], onDelete: Cascade)
  charge          PaymentCharge?  @relation(fields: [storeId, chargeId], references: [storeId, id], onDelete: Cascade)

  @@unique([provider, providerEventId])
  @@index([storeId, createdAt(sort: Desc)])
  @@map("payment_events")
}

/// Obrigação de repasse piloto — não é extrato bancário nem payout automático.
model LedgerEntry {
  id                String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  storeId           String          @map("store_id") @db.Uuid
  orderId           String          @unique @map("order_id") @db.Uuid
  chargeId          String          @unique @map("charge_id") @db.Uuid
  provider          PaymentProvider
  grossCents        Int             @map("gross_cents")
  feeBps            Int             @map("fee_bps")
  feeCents          Int             @map("fee_cents")
  netCents          Int             @map("net_cents")
  expectedPayoutAt  DateTime        @map("expected_payout_at") @db.Date
  paidAt            DateTime?       @map("paid_at") @db.Timestamptz(3)
  createdAt         DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)
  store             Store           @relation(fields: [storeId], references: [id], onDelete: Cascade)
  order             Order           @relation(fields: [storeId, orderId], references: [storeId, id], onDelete: Cascade)
  charge            PaymentCharge   @relation(fields: [storeId, chargeId], references: [storeId, id], onDelete: Cascade)

  @@unique([storeId, id])
  @@unique([storeId, orderId])
  @@unique([storeId, chargeId])
  @@index([storeId, expectedPayoutAt])
  @@index([storeId, paidAt])
  @@map("ledger_entries")
}

model OrderLine {
  id                   String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  storeId              String   @map("store_id") @db.Uuid
  orderId              String   @map("order_id") @db.Uuid
  sortOrder            Int      @map("sort_order")
  menuItemId           String?  @map("menu_item_id") @db.Uuid
  itemName             String   @map("item_name")
  unitPriceCents       Int      @map("unit_price_cents")
  quantity             Int
  lineTotalCents       Int      @map("line_total_cents")
  complementSnapshots  Json     @map("complement_snapshots")
  additionalSnapshots  Json     @map("additional_snapshots")
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  store                Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  order                Order    @relation(fields: [storeId, orderId], references: [storeId, id], onDelete: Cascade)

  @@index([storeId, orderId, sortOrder])
  @@index([orderId])
  @@map("order_lines")
}
