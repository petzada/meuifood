# Observabilidade opcional. A execução local funciona sem DSN.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# Porta HTTP da API.
PORT=3333

# DATABASE_URL é privilegiada e exclusiva para migrations/seed/admin consciente.
DATABASE_URL=
# BUSINESS_DATABASE_URL é a credencial de runtime sujeita às policies RLS.
BUSINESS_DATABASE_URL=

# Supabase Auth do projeto Foode Delivery. O service role fica exclusivamente
# no adapter Auth Admin da API e nunca é usado pelo Prisma.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
ADMIN_AUTH_REDIRECT_URL=

# Cloudflare R2 — imagens do Cardápio (decisões 57/59/64): sem credenciais S3 nem URL
# pré-assinada. A api grava pelo binding MEDIA (apps/api/wrangler.jsonc) e serve em GET /media/*.
# Base pública de leitura (var da api; padrão no wrangler.jsonc):
MEDIA_PUBLIC_BASE_URL=
