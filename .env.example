# Variáveis da stack Cloudflare (Workers + D1 + R2). Sem valores aqui: em produção os segredos
# vêm dos secrets do GitHub (deploy.yml, `--secrets-file`) e as vars dos `wrangler.jsonc`/GitHub
# variables. No `wrangler dev` da api, segredos ficam em `apps/api/.dev.vars` (fora do git).
# Os apps Next leem `apps/web/.env.example` e `apps/admin/.env.example`.

# --- api (foode-api) ---
# Segredos
BETTER_AUTH_SECRET=
MILLIONSEND_API_KEY=
TURNSTILE_SECRET_KEY=
ORDER_TOKEN_SECRET=
PHONE_LOOKUP_IP_SALT=
SENTRY_DSN=
# Vars (padrão em apps/api/wrangler.jsonc)
BETTER_AUTH_URL=
EMAIL_FROM=
MEDIA_PUBLIC_BASE_URL=

# --- CI/deploy (GitHub secrets/variables; só referência) ---
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_ZONE_ID=
D1_PROD_DATABASE_ID=
TURNSTILE_SITE_KEY=
SENTRY_DSN_API=
SENTRY_DSN_WEB=
SENTRY_DSN_ADMIN=
FOODE_OPS_EMAILS=
SMOKE_API_URL=
SMOKE_WEB_URL=
SMOKE_ADMIN_URL=
