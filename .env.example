# Observabilidade opcional. A execução local funciona sem DSN.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# Porta HTTP da API.
PORT=3333

# DATABASE_URL é privilegiada e exclusiva para migrations/seed/admin consciente.
DATABASE_URL=
# BUSINESS_DATABASE_URL é a credencial de runtime sujeita às policies RLS.
BUSINESS_DATABASE_URL=

# Supabase Auth do projeto Foode Delivery. O service role fica exclusivamente
# no adapter Auth Admin da API e nunca é usado pelo Prisma.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
ADMIN_AUTH_REDIRECT_URL=

# Cloudflare R2 — imagens do Cardápio (somente na API / Railway; nunca no frontend).
# Leitura pública via R2_PUBLIC_BASE_URL; upload via PUT pré-assinado emitido pela API.
# Ver docs/decisoes/57-cloudflare-r2-imagens-cardapio.md.
#
# CORS do bucket (origem factual do Admin, métodos PUT, header Content-Type):
# AllowedOrigins: a origem HTTPS do Painel (ex.: https://admin.foodedelivery.com.br
# e http://localhost:3001 em desenvolvimento).
# AllowedMethods: PUT
# AllowedHeaders: Content-Type
# ExposeHeaders: ETag
# MaxAgeSeconds: 3600
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=
